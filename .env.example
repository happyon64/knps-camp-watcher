PORT=3000
APP_BASE_URL=https://your-domain.example

# 휴대폰 관리 화면 보호용 계정
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-this-to-a-long-random-password

# Kakao Developers > 내 애플리케이션에서 발급
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://your-domain.example/oauth/kakao/callback

# 감시 간격: 일정 공개 전 15분, 공개 후 4분 + 최대 90초 무작위 지연
INTERVAL_UNOPENED_SECONDS=900
INTERVAL_OPEN_SECONDS=240
JITTER_SECONDS=90

# 상태 파일을 영구 볼륨에 보관
DATA_DIR=./data
HEADLESS=true
